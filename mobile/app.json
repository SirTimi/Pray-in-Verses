{
  "expo": {
    "name": "Pray in Verses",
    "slug": "pray-in-verses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pray-in-verses",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.prayinverses.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C2E8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFEF8",
          "image": "./assets/images/PIV-logo.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "283c8c7d-7fed-4822-ae3e-07d50a2a6d9c"
      }
    }
  }
}
